# Copy to server/.env. .env is git-ignored; never commit real keys.
PORT=4000
NODE_ENV=development
JWT_SECRET=dev-only-secret-change-me-in-production
CORS_ORIGIN=http://localhost:5173
# DATABASE_PATH=./data/kenpath.db

# AI (optional). Without a key the app uses rule-based case notes.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
# Set to true to simulate an AI outage.
AI_DISABLED=false

# Service-guarantee period for a caste certificate (days).
SLA_DAYS=15
